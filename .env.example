APP_NAME="Southville Phase I HOA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# One-time production bootstrap values for AdminUserSeeder. Leave blank for normal operation.
HOA_INITIAL_ADMIN_FIRST_NAME=
HOA_INITIAL_ADMIN_MIDDLE_NAME=
HOA_INITIAL_ADMIN_LAST_NAME=
HOA_INITIAL_ADMIN_SUFFIX=
HOA_INITIAL_ADMIN_SEX=
HOA_INITIAL_ADMIN_CONTACT_NUMBER=
HOA_INITIAL_ADMIN_DATE_OF_BIRTH=
HOA_INITIAL_ADMIN_EMAIL=
HOA_INITIAL_ADMIN_PASSWORD=
HOA_INITIAL_ADMIN_PASSWORD_CONFIRMATION=

# Set these only after retaining dated external evidence for each release gate.
HOA_QUEUE_WORKER_VERIFIED=false
HOA_SCHEDULER_VERIFIED=false
HOA_BACKUP_RESTORE_VERIFIED=false
HOA_MAIL_DELIVERY_VERIFIED=false
HOA_PRIVATE_STORAGE_VERIFIED=false
HOA_SECURITY_INCIDENT_CLOSED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hoa_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development writes notifications to the application log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_TIMEOUT=30
# Production Gmail SMTP (use an app password; never commit credentials):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="hoa@example.com"
# MAIL_FROM_NAME="${APP_NAME}"
MAIL_FROM_ADDRESS="hoa@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TextBee: use a new private API key. Default configuration cannot send real SMS.
TEXTBEE_ENABLED=false
TEXTBEE_TEST_MODE=true
TEXTBEE_TEST_NUMBERS=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=6af13a260aecd9e3040dc00d

# Supply your own appropriately licensed font privately; never add it to public assets.
# Relative paths resolve against the Laravel project root; absolute paths are also supported.
# Without an override, Residency prefers storage/app/private/fonts/timesbd.ttf.
# CERTIFICATE_RESIDENCY_FONT=storage/app/private/fonts/timesbd.ttf
